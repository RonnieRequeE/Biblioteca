@page "/autores"
@inject AutorService AutorService

<h3>GESTIÓN DE AUTORES</h3>

<!-- Sección de búsqueda y filtros -->
<div style="background-color: #f9f9f9; padding: 15px; border: 1px solid #ddd; margin-bottom: 20px; border-radius: 4px;">
    <h4 style="margin-top: 0;">Filtros y Búsqueda</h4>
    <div style="display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end;">
        <div>
            <label style="display: block; font-weight: bold; margin-bottom: 5px;">Buscar por nombre/apellido:</label>
            <input type="text" @bind="textoBusqueda" placeholder="Escriba nombre..." style="padding: 6px; width: 200px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div>
            <label style="display: block; font-weight: bold; margin-bottom: 5px;">Estado:</label>
            <select @bind="filtroEstado" style="padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="Todos">Todos</option>
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
            </select>
        </div>
        <div>
            <label style="display: block; font-weight: bold; margin-bottom: 5px;">Nacionalidad:</label>
            <select @bind="filtroNacionalidad" style="padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="Todas">Todas</option>
                @foreach (var nac in nacionalidades)
                {
                    <option value="@nac">@nac</option>
                }
            </select>
        </div>
        <div>
            <button @onclick="AplicarFiltros" style="padding: 7px 15px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Buscar / Filtrar</button>
            <button @onclick="LimpiarFiltros" style="padding: 7px 15px; background-color: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-left: 5px;">Limpiar</button>
        </div>
    </div>
</div>

<button @onclick="MostrarCrearForm" style="padding: 8px 15px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-bottom: 15px;">+ Nuevo Autor</button>

<!-- Formulario para Crear / Editar -->
@if (mostrarFormulario)
{
    <div style="background-color: #fff; padding: 20px; border: 2px solid #333; margin-bottom: 20px; border-radius: 6px; max-width: 500px;">
        <h4>@(autorForm.Id == null ? "CREAR NUEVO AUTOR" : "EDITAR AUTOR")</h4>
        
        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div style="color: red; font-weight: bold; margin-bottom: 10px;">@mensajeError</div>
        }

        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Nombre:</label>
            <input type="text" @bind="autorForm.Nombre" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Apellido:</label>
            <input type="text" @bind="autorForm.Apellido" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Nacionalidad:</label>
            <input type="text" @bind="autorForm.Nacionalidad" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Fecha de Nacimiento:</label>
            <input type="date" @bind="autorForm.FechaNacimiento" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Género:</label>
            <select @bind="autorForm.Genero" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="">-- Seleccionar --</option>
                <option value="Masculino">Masculino</option>
                <option value="Femenino">Femenino</option>
                <option value="Otro">Otro</option>
            </select>
        </div>
        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Biografía:</label>
            <textarea @bind="autorForm.Biografia" rows="3" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;"></textarea>
        </div>
        <div style="margin-bottom: 15px;">
            <label style="display: block; font-weight: bold;">Estado:</label>
            <select @bind="autorForm.Estado" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
            </select>
        </div>

        <button @onclick="GuardarAutor" style="padding: 8px 16px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Guardar</button>
        <button @onclick="CancelarFormulario" style="padding: 8px 16px; background-color: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-left: 10px;">Cancelar</button>
    </div>
}

<!-- Tabla de Registros -->
<table style="width: 100%; border-collapse: collapse; border: 1px solid #ddd;">
    <thead>
        <tr style="background-color: #f2f2f2; border-bottom: 2px solid #ddd;">
            <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Nombre Completo</th>
            <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Nacionalidad</th>
            <th style="padding: 10px; text-align: center; border: 1px solid #ddd;">F. Nacimiento</th>
            <th style="padding: 10px; text-align: center; border: 1px solid #ddd;">Género</th>
            <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Biografía</th>
            <th style="padding: 10px; text-align: center; border: 1px solid #ddd;">Estado</th>
            <th style="padding: 10px; text-align: center; border: 1px solid #ddd;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (autoresFiltrados.Count == 0)
        {
            <tr>
                <td colspan="7" style="padding: 15px; text-align: center; color: #777;">No se encontraron autores.</td>
            </tr>
        }
        else
        {
            @foreach (var autor in autoresFiltrados)
            {
                <tr style="border-bottom: 1px solid #ddd;">
                    <td style="padding: 10px; border: 1px solid #ddd;">@(autor.Nombre + " " + autor.Apellido)</td>
                    <td style="padding: 10px; border: 1px solid #ddd;">@autor.Nacionalidad</td>
                    <td style="padding: 10px; text-align: center; border: 1px solid #ddd;">@(autor.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td style="padding: 10px; text-align: center; border: 1px solid #ddd;">@autor.Genero</td>
                    <td style="padding: 10px; border: 1px solid #ddd;">@autor.Biografia</td>
                    <td style="padding: 10px; text-align: center; border: 1px solid #ddd;">
                        <span style="padding: 3px 8px; border-radius: 12px; font-size: 0.85em; font-weight: bold; background-color: @(autor.Estado == "Activo" ? "#d4edda" : "#f8d7da"); color: @(autor.Estado == "Activo" ? "#155724" : "#721c24");">
                            @autor.Estado
                        </span>
                    </td>
                    <td style="padding: 10px; text-align: center; border: 1px solid #ddd;">
                        <button @onclick="() => MostrarEditarForm(autor)" style="padding: 4px 8px; background-color: #ffc107; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-right: 5px;">Editar</button>
                        @if (autor.Estado == "Activo")
                        {
                            <button @onclick="() => EliminarLogico(autor.Id)" style="padding: 4px 8px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Eliminar</button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Autor> autores = new();
    private List<Autor> autoresFiltrados = new();
    private List<string> nacionalidades = new();

    // Filtros
    private string textoBusqueda = "";
    private string filtroEstado = "Todos";
    private string filtroNacionalidad = "Todas";

    // Formulario
    private bool mostrarFormulario = false;
    private Autor autorForm = new();
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        autores = await AutorService.GetAsync();
        
        // Obtener lista única de nacionalidades para el filtro
        var listaNac = new HashSet<string>();
        foreach (var aut in autores)
        {
            if (!string.IsNullOrWhiteSpace(aut.Nacionalidad))
            {
                listaNac.Add(aut.Nacionalidad);
            }
        }
        nacionalidades = listaNac.ToList();

        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        autoresFiltrados = autores;

        // Búsqueda por texto (Nombre o Apellido)
        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            autoresFiltrados = autoresFiltrados.FindAll(a => 
                a.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) || 
                a.Apellido.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
            );
        }

        // Filtro por Estado
        if (filtroEstado != "Todos")
        {
            autoresFiltrados = autoresFiltrados.FindAll(a => a.Estado == filtroEstado);
        }

        // Filtro por Nacionalidad
        if (filtroNacionalidad != "Todas")
        {
            autoresFiltrados = autoresFiltrados.FindAll(a => a.Nacionalidad == filtroNacionalidad);
        }
    }

    private void LimpiarFiltros()
    {
        textoBusqueda = "";
        filtroEstado = "Todos";
        filtroNacionalidad = "Todas";
        AplicarFiltros();
    }

    private void MostrarCrearForm()
    {
        autorForm = new Autor
        {
            FechaNacimiento = DateTime.Today.AddYears(-30),
            Estado = "Activo"
        };
        mensajeError = "";
        mostrarFormulario = true;
    }

    private void MostrarEditarForm(Autor autor)
    {
        autorForm = new Autor
        {
            Id = autor.Id,
            Nombre = autor.Nombre,
            Apellido = autor.Apellido,
            Nacionalidad = autor.Nacionalidad,
            FechaNacimiento = autor.FechaNacimiento,
            Genero = autor.Genero,
            Biografia = autor.Biografia,
            Estado = autor.Estado
        };
        mensajeError = "";
        mostrarFormulario = true;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        mensajeError = "";
    }

    private async Task GuardarAutor()
    {
        if (string.IsNullOrWhiteSpace(autorForm.Nombre) || 
            string.IsNullOrWhiteSpace(autorForm.Apellido) || 
            string.IsNullOrWhiteSpace(autorForm.Nacionalidad) ||
            string.IsNullOrWhiteSpace(autorForm.Genero) ||
            string.IsNullOrWhiteSpace(autorForm.Biografia))
        {
            mensajeError = "Todos los campos son obligatorios.";
            return;
        }

        if (autorForm.Id == null)
        {
            await AutorService.CreateAsync(autorForm);
        }
        else
        {
            await AutorService.UpdateAsync(autorForm.Id, autorForm);
        }

        mostrarFormulario = false;
        await CargarDatos();
    }

    private async Task EliminarLogico(string id)
    {
        if (id != null)
        {
            await AutorService.DeleteLogicAsync(id);
            await CargarDatos();
        }
    }
}
