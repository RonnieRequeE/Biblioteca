@page "/"
@inject LibroService LibroService
@inject AutorService AutorService
@inject CategoriaService CategoriaService

<h3>GESTIÓN DE LIBROS</h3>

<!-- Sección de búsqueda y filtros -->
<div style="background-color: #f9f9f9; padding: 15px; border: 1px solid #ddd; margin-bottom: 20px; border-radius: 4px;">
    <h4 style="margin-top: 0;">Filtros y Búsqueda</h4>
    <div style="display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end;">
        <div>
            <label style="display: block; font-weight: bold; margin-bottom: 5px;">Buscar por título:</label>
            <input type="text" @bind="textoBusqueda" placeholder="Escriba título..." style="padding: 6px; width: 200px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div>
            <label style="display: block; font-weight: bold; margin-bottom: 5px;">Estado:</label>
            <select @bind="filtroEstado" style="padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="Todos">Todos</option>
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
            </select>
        </div>
        <div>
            <label style="display: block; font-weight: bold; margin-bottom: 5px;">Categoría:</label>
            <select @bind="filtroCategoria" style="padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="Todas">Todas</option>
                @foreach (var cat in categorias)
                {
                    <option value="@cat.Nombre">@cat.Nombre</option>
                }
            </select>
        </div>
        <div>
            <button @onclick="AplicarFiltros" style="padding: 7px 15px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Buscar / Filtrar</button>
            <button @onclick="LimpiarFiltros" style="padding: 7px 15px; background-color: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-left: 5px;">Limpiar</button>
        </div>
    </div>
</div>

<button @onclick="MostrarCrearForm" style="padding: 8px 15px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-bottom: 15px;">+ Nuevo Libro</button>

<!-- Formulario para Crear / Editar -->
@if (mostrarFormulario)
{
    <div style="background-color: #fff; padding: 20px; border: 2px solid #333; margin-bottom: 20px; border-radius: 6px; max-width: 500px;">
        <h4>@(libroForm.Id == null ? "CREAR NUEVO LIBRO" : "EDITAR LIBRO")</h4>
        
        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div style="color: red; font-weight: bold; margin-bottom: 10px;">@mensajeError</div>
        }

        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Título:</label>
            <input type="text" @bind="libroForm.Titulo" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Autor:</label>
            <select @bind="libroForm.Autor" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="">-- Seleccionar Autor --</option>
                @foreach (var aut in autores)
                {
                    <option value="@(aut.Nombre + " " + aut.Apellido)">@(aut.Nombre + " " + aut.Apellido)</option>
                }
            </select>
        </div>
        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Categoría:</label>
            <select @bind="libroForm.Categoria" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="">-- Seleccionar Categoría --</option>
                @foreach (var cat in categorias)
                {
                    <option value="@cat.Nombre">@cat.Nombre</option>
                }
            </select>
        </div>
        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Año de Publicación:</label>
            <input type="number" @bind="libroForm.AnioPublicacion" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 10px;">
            <label style="display: block; font-weight: bold;">Editorial:</label>
            <input type="text" @bind="libroForm.Editorial" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" />
        </div>
        <div style="margin-bottom: 15px;">
            <label style="display: block; font-weight: bold;">Estado:</label>
            <select @bind="libroForm.Estado" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
            </select>
        </div>

        <button @onclick="GuardarLibro" style="padding: 8px 16px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Guardar</button>
        <button @onclick="CancelarFormulario" style="padding: 8px 16px; background-color: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-left: 10px;">Cancelar</button>
    </div>
}

<!-- Tabla de Registros -->
<table style="width: 100%; border-collapse: collapse; border: 1px solid #ddd;">
    <thead>
        <tr style="background-color: #f2f2f2; border-bottom: 2px solid #ddd;">
            <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Título</th>
            <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Autor</th>
            <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Categoría</th>
            <th style="padding: 10px; text-align: center; border: 1px solid #ddd;">Año</th>
            <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Editorial</th>
            <th style="padding: 10px; text-align: center; border: 1px solid #ddd;">Estado</th>
            <th style="padding: 10px; text-align: center; border: 1px solid #ddd;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (librosFiltrados.Count == 0)
        {
            <tr>
                <td colspan="7" style="padding: 15px; text-align: center; color: #777;">No se encontraron libros.</td>
            </tr>
        }
        else
        {
            @foreach (var libro in librosFiltrados)
            {
                <tr style="border-bottom: 1px solid #ddd;">
                    <td style="padding: 10px; border: 1px solid #ddd;">@libro.Titulo</td>
                    <td style="padding: 10px; border: 1px solid #ddd;">@libro.Autor</td>
                    <td style="padding: 10px; border: 1px solid #ddd;">@libro.Categoria</td>
                    <td style="padding: 10px; text-align: center; border: 1px solid #ddd;">@libro.AnioPublicacion</td>
                    <td style="padding: 10px; border: 1px solid #ddd;">@libro.Editorial</td>
                    <td style="padding: 10px; text-align: center; border: 1px solid #ddd;">
                        <span style="padding: 3px 8px; border-radius: 12px; font-size: 0.85em; font-weight: bold; background-color: @(libro.Estado == "Activo" ? "#d4edda" : "#f8d7da"); color: @(libro.Estado == "Activo" ? "#155724" : "#721c24");">
                            @libro.Estado
                        </span>
                    </td>
                    <td style="padding: 10px; text-align: center; border: 1px solid #ddd; white-space: nowrap;">
                        <button @onclick="() => MostrarEditarForm(libro)" style="padding: 4px 8px; background-color: #ffc107; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-right: 5px;">Editar</button>
                        @if (libro.Estado == "Activo")
                        {
                            <button @onclick="() => EliminarLogico(libro.Id)" style="padding: 4px 8px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Eliminar</button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Libro> libros = new();
    private List<Libro> librosFiltrados = new();
    private List<Autor> autores = new();
    private List<Categoria> categorias = new();

    // Filtros
    private string textoBusqueda = "";
    private string filtroEstado = "Todos";
    private string filtroCategoria = "Todas";

    // Formulario
    private bool mostrarFormulario = false;
    private Libro libroForm = new();
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        libros = await LibroService.GetAsync();
        autores = await AutorService.GetAsync();
        categorias = await CategoriaService.GetAsync();
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        librosFiltrados = libros;

        // Búsqueda por texto (Título)
        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            librosFiltrados = librosFiltrados.FindAll(l => l.Titulo.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));
        }

        // Filtro por Estado
        if (filtroEstado != "Todos")
        {
            librosFiltrados = librosFiltrados.FindAll(l => l.Estado == filtroEstado);
        }

        // Filtro por Categoría
        if (filtroCategoria != "Todas")
        {
            librosFiltrados = librosFiltrados.FindAll(l => l.Categoria == filtroCategoria);
        }
    }

    private void LimpiarFiltros()
    {
        textoBusqueda = "";
        filtroEstado = "Todos";
        filtroCategoria = "Todas";
        AplicarFiltros();
    }

    private void MostrarCrearForm()
    {
        libroForm = new Libro
        {
            AnioPublicacion = DateTime.Now.Year,
            Estado = "Activo"
        };
        mensajeError = "";
        mostrarFormulario = true;
    }

    private void MostrarEditarForm(Libro libro)
    {
        libroForm = new Libro
        {
            Id = libro.Id,
            Titulo = libro.Titulo,
            Autor = libro.Autor,
            Categoria = libro.Categoria,
            AnioPublicacion = libro.AnioPublicacion,
            Editorial = libro.Editorial,
            Estado = libro.Estado
        };
        mensajeError = "";
        mostrarFormulario = true;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        mensajeError = "";
    }

    private async Task GuardarLibro()
    {
        if (string.IsNullOrWhiteSpace(libroForm.Titulo) || 
            string.IsNullOrWhiteSpace(libroForm.Autor) || 
            string.IsNullOrWhiteSpace(libroForm.Categoria) ||
            string.IsNullOrWhiteSpace(libroForm.Editorial))
        {
            mensajeError = "Todos los campos son obligatorios.";
            return;
        }

        if (libroForm.AnioPublicacion <= 0)
        {
            mensajeError = "Ingrese un año de publicación válido.";
            return;
        }

        if (libroForm.Id == null)
        {
            await LibroService.CreateAsync(libroForm);
        }
        else
        {
            await LibroService.UpdateAsync(libroForm.Id, libroForm);
        }

        mostrarFormulario = false;
        await CargarDatos();
    }

    private async Task EliminarLogico(string id)
    {
        if (id != null)
        {
            await LibroService.DeleteLogicAsync(id);
            await CargarDatos();
        }
    }
}
